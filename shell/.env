[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

export GOPATH="$HOME/go"
export BUN_INSTALL="$HOME/.bun"
export PATH="$HOME/.local/bin:$BUN_INSTALL/bin:$GOPATH/bin:$HOME/.npm-packages/bin:$HOME/.luarocks/bin:$HOME/neovim/bin:$PATH"

export EDITOR=nvim
export BACON_PREFS=~/.config/bacon/prefs.toml
export PAGER=moor
export MOOR="--colors=16M --terminal-fg"
export NODE_PATH=~/.npm-packages/lib/node_modules
export BAT_THEME="evergarden-winter"
